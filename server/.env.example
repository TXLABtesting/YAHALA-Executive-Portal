# Copy to .env and adjust for your environment.

# PostgreSQL connection
DATABASE_URL=postgres://yahala:yahala_dev@127.0.0.1:5432/yahala

# HTTP
PORT=4000

# Session signing secret — generate a long random value for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Shared portal password (admin sign-in). Used by `npm run seed` on first run only;
# afterwards change it from the database (see scripts/set-password.js).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Comma-separated origins allowed to call the API in development.
CORS_ORIGIN=http://localhost:5173
